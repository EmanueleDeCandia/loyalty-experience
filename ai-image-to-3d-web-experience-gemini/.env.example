# API Node (stesso repository)
API_PORT=8787
API_HOST=0.0.0.0
DATABASE_PATH=data/loyalty.sqlite
DAILY_PASS_ALLOWANCE=20
DANTE_STORE_URL=https://store.dantefestival.it/checkout

# ISO 8601 con fuso orario. Se vuoto, la UI mostra “Data Festival in arrivo”.
FESTIVAL_START_AT=2026-10-10T18:00:00+02:00

# Obbligatoria in produzione per l'endpoint POST /api/vouchers/:code/redeem
CASHIER_API_KEY=change-me

# Provider esterni opzionali. Apple deve restituire un .pkpass firmato;
# Google deve generare il link Save to Google Wallet.
APPLE_WALLET_BASE_URL=
GOOGLE_WALLET_BASE_URL=
